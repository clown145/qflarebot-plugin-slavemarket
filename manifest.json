        "minimum": 0
      },
      "purchase_cooldown": {
        "type": "integer",
        "title": "购买冷却（秒）",
        "default": 3600,
        "minimum": 0
      },
      "bank_initial_limit": {
        "type": "integer",
        "title": "银行初始存储上限",
        "default": 1000,
        "minimum": 0

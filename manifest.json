      "ranking_tier_bonus_silver": {
        "type": "number",
        "title": "白银段位奖励倍率",
        "default": 1.2,
        "minimum": 0
      },
      "ranking_tier_bonus_gold": {
        "type": "number",
        "title": "黄金段位奖励倍率",
        "default": 1.5,
        "minimum": 0
      },
      "ranking_tier_bonus_platinum": {
        "type": "number",
        "title": "铂金段位奖励倍率",
        "default": 2,
        "minimum": 0
      },
      "ranking_tier_bonus_diamond": {
        "type": "number",
        "title": "钻石段位奖励倍率",
        "default": 3,
        "minimum": 0
      },
      "transfer_fee_rate": {
        "type": "number",
        "title": "转账手续费率（0-1）",
        "default": 0.1,
        "minimum": 0,
        "maximum": 1
      },
      "transfer_min_amount": {
        "type": "integer",
        "title": "最低转账金额",
        "default": 100,
        "minimum": 0
      },
      "weekly_reset_enabled": {
        "type": "boolean",
        "title": "每周重置",
        "description": "到点后本群的第一条命令开启新的一周：所有人回到初始状态，上周排行榜留一份可查。只重置用过的群，不用定时推送",
        "default": true
      },
      "reset_day": {
        "type": "integer",
        "title": "重置日（0=周日，1=周一 … 6=周六，北京时间）",
        "default": 1,
        "minimum": 0,
        "maximum": 6
      },
      "reset_hour": {
        "type": "integer",
        "title": "重置小时（0-23）",
        "default": 0,
        "minimum": 0,
        "maximum": 23
      },
      "reset_minute": {
        "type": "integer",
        "title": "重置分钟（0-59）",
        "default": 0,
        "minimum": 0,
        "maximum": 59
      },
      "reset_keep_nickname": {
        "type": "boolean",
        "title": "重置时保留昵称",
        "default": true
      },
      "reset_base_value": {
        "type": "integer",
        "title": "重置后的基础身价",
        "default": 100,
        "minimum": 0
      },
      "ignore_cd_users": {
        "type": "array",
        "title": "无视冷却的用户 openid",
        "description": "在群里发内置插件的 /sid 可以查到自己的 openid",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "slaveowner_users": {
        "type": "array",
        "title": "尊贵的奴隶主 openid",
        "description": "没有奴隶时打工按奴隶主算：收入更高、冷却按上面的「尊贵的奴隶主打工冷却」",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "use_image": {
        "type": "boolean",
        "title": "用图片回复",
        "description": "打工报告、一键训练、排行榜、市场、帮助等用内置 T2I 插件渲染成图；关掉或渲染失败时发文字",
        "default": true
      },
      "market_limit": {
        "type": "integer",
        "title": "奴隶市场最多展示几人（按身价从高到低）",
        "default": 100,
        "minimum": 1,
        "maximum": 300
      },
      "prune_weeks": {
        "type": "integer",
        "title": "清理多少周没玩过的玩家数据（0 = 不清理）",
        "default": 4,
        "minimum": 0
      }
    }
  },
  "defaultConfig": {
    "buyback_cooldown": 86400,

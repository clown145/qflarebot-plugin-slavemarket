{
  "name": "slavemarket",
  "version": "0.1.2",
  "apiVersion": 1,
  "permissions": [
    "db"
  ],
  "depends": {
    "t2i": "*"
  },
  "conflicts": [],
  "commands": [
    {
      "name": "打工",
      "aliases": [
        "工作",
        "一键打工",
        "一键工作"
      ],
      "description": "打工赚金币，有奴隶就派奴隶去"
    },
    {
      "name": "购买奴隶",
      "aliases": [
        "购买群友"
      ],
      "usage": "/购买奴隶 @群友 或 /购买奴隶 市场编号",
      "description": "买下群友当奴隶"
    },
    {
      "name": "我的奴隶",
      "aliases": [
        "我的群友"
      ],
      "description": "看自己的金币、身价和奴隶"
    },
    {
      "name": "奴隶市场",
      "aliases": [
        "群友市场"
      ],
      "description": "看全群的身价和主人"
    },
    {
      "name": "放生奴隶",
      "aliases": [
        "放生群友"
      ],
      "usage": "/放生奴隶 序号 或 /放生奴隶 @群友",
      "description": "放走自己的奴隶"
    },
    {
      "name": "赎身",
      "description": "两倍身价买回自己"
    },
    {
      "name": "抢劫",
      "aliases": [
        "打劫"
      ],
      "usage": "/抢劫 或 /抢劫 @群友",
      "description": "抢别人的金币，不@就随机"
    },
    {
      "name": "存款",
      "usage": "/存款 金额",
      "description": "把金币存进银行"
    },
    {
      "name": "一键存款",
      "description": "能存多少存多少"
    },
    {
      "name": "取款",
      "usage": "/取款 金额",
      "description": "从银行取出金币"
    },
    {
      "name": "升级信用",
      "description": "提升银行存储上限"
    },
    {
      "name": "一键升级信用",
      "description": "钱够就一直升级信用"
    },
    {
      "name": "银行信息",
      "description": "看存款、上限和利息"
    },
    {
      "name": "领取利息",
      "description": "领取存款利息"
    },
    {
      "name": "转账",
      "usage": "/转账 金额 @群友",
      "description": "给群友转金币，收手续费"
    },
    {
      "name": "训练",
      "usage": "/训练 序号 或 /训练 @群友",
      "description": "训练奴隶提升身价"
    },
    {
      "name": "一键训练",
      "description": "训练所有奴隶"
    },
    {
      "name": "决斗",
      "usage": "/决斗 我的奴隶序号 对手（@群友或序号）",
      "description": "让奴隶和别人的奴隶决斗"
    },
    {
      "name": "排位赛",
      "description": "看奴隶的段位和分数"
    },
    {
      "name": "参加排位赛",
      "usage": "/参加排位赛 序号 或 /参加排位赛 @群友",
      "description": "让奴隶打排位赛拿奖励"
    },
    {
      "name": "奴隶身价排行榜",
      "description": "本群身价前 15 名"
    },
    {
      "name": "奴隶资金排行榜",
      "description": "本群金币前 15 名"
    },
    {
      "name": "上周排行榜",
      "description": "上周四个榜的回顾"
    },
    {
      "name": "奴隶重置状态",
      "description": "每周重置的时间和记录"
    },
    {
      "name": "手动奴隶重置",
      "permission": "group_admin",
      "usage": "/手动奴隶重置，再点确认或发 /手动奴隶重置 确认",
      "description": "清空本群的游戏数据"
    },
    {
      "name": "奴隶重置帮助",
      "description": "每周重置的说明"
    },
    {
      "name": "奴隶帮助",
      "aliases": [
        "奴隶菜单",
        "nl帮助",
        "nl菜单",
        "群友帮助",
        "群友菜单"
      ],
      "description": "奴隶市场的全部指令"
    }
  ],
  "regex": [],
  "events": [
    {
      "event": [
        "qq.group.member_removed"
      ]
    }
  ],
  "buttons": [
    {
      "id": "slave_reset"
    }
  ],
  "cron": [
    {
      "name": "prune",
      "cron": "23 20 * * 0"
    }
  ],
  "routes": [],
  "hasMiddleware": false,
  "services": [],
  "durableObjects": [],
  "displayName": "奴隶市场",
  "description": "群聊文字游戏：打工赚钱、买卖群友当奴隶、训练、决斗、排位赛、银行、排行榜，每周自动重置",
  "configSchema": {
    "type": "object",
    "properties": {
      "buyback_cooldown": {
        "type": "integer",
        "title": "赎身冷却（秒）",
        "default": 86400,
        "minimum": 0
      },
      "buyback_max_times": {
        "type": "integer",
        "title": "每周最多赎身次数",
        "default": 3,
        "minimum": 1
      },
      "buyback_tax_rate": {
        "type": "number",
        "title": "赎身税率（0-1）",
        "default": 0.05,
        "minimum": 0,
        "maximum": 1
      },
      "rob_cooldown": {
        "type": "integer",
        "title": "抢劫冷却（秒）",
        "default": 600,
        "minimum": 0
      },
      "rob_success_rate": {
        "type": "number",
        "title": "抢劫成功率（0-1）",
        "default": 0.3,
        "minimum": 0,
        "maximum": 1
      },
      "rob_penalty": {
        "type": "number",
        "title": "抢劫失败罚金比例（0-1）",
        "default": 0.1,
        "minimum": 0,
        "maximum": 1
      },
      "work_cooldown": {
        "type": "integer",
        "title": "打工冷却（秒）",
        "default": 3600,
        "minimum": 0
      },
      "work_slaveowner_cooldown": {
        "type": "integer",
        "title": "尊贵的奴隶主打工冷却（秒）",
